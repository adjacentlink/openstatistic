from distutils.core import setup, Extension

ostatistic_lib = Extension('ostatistic.lib',
                           extra_compile_args=['-std=c++17'],
                           include_dirs=['../../include'],
                           library_dirs=['../../src/libostatistic/.libs'],
                           libraries = ['ostatistic'],
                           sources = [
                               'src/extboolean.cc',
                               'src/extdouble.cc',
                               'src/extservice.cc',
                               'src/extsignedinteger.cc',
                               'src/extstring.cc',
                               'src/exttable.cc',
                               'src/extunsignedinteger.cc',
                               'src/libostatistic.cc'])

setup(name='openstatistic',
      version='@VERSION@',
      description='OpenStatistic Python Tools',
      long_description='OpenStatistic Python Tools',
      author='Adjacent Link LLC',
      author_email='labs at adjacent link dot com',
      url="https://adjacentlink.com",
       packages=['ostatistic',
                 'ostatistic.interface',
                 'otestpoint',
                 'otestpoint.ostatistic'],
      scripts=['scripts/ostatistic'],
      license = 'BSD',
      ext_modules = [ostatistic_lib]
)
